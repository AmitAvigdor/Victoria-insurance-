# Supabase project URL and public publishable (or legacy anon) key. NEVER a service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: enable fictional, device-local sandbox even in a production demo build.
# Defaults to enabled only in development when Supabase is not configured.
VITE_ENABLE_DEMO=false
